{
  "name": "@_linked/calendar",
  "version": "0.1.0",
  "description": "A shape-agnostic, controlled LINKED calendar engine shared by Serve and Create Now applications.",
  "linkedPackage": true,
  "type": "module",
  "main": "lib/cjs/index.js",
  "module": "lib/esm/index.js",
  "types": "lib/esm/index.d.ts",
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/linked-cm/calendar.git"
  },
  "homepage": "https://github.com/linked-cm/calendar#readme",
  "bugs": {
    "url": "https://github.com/linked-cm/calendar/issues"
  },
  "files": [
    "lib",
    "src/translations/en.json",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "sideEffects": [
    "./src/package.ts",
    "./src/Calendar.module.css"
  ],
  "publishConfig": {
    "access": "public"
  },
  "linkedTranslationCatalog": "src/translations/en.json",
  "scripts": {
    "start": "npm exec linked dev",
    "build": "npm exec linked build && node ./scripts/verify-build.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --config vitest.config.ts",
    "prepublishOnly": "npm exec linked build production && node ./scripts/verify-build.mjs",
    "postpublish": "npm exec linked register"
  },
  "exports": {
    ".": {
      "types": "./lib/esm/index.d.ts",
      "development": "./src/index.ts",
      "import": "./lib/esm/index.js",
      "require": "./lib/cjs/index.js"
    },
    "./package": {
      "types": "./lib/esm/package.d.ts",
      "development": "./src/package.ts",
      "import": "./lib/esm/package.js",
      "require": "./lib/cjs/package.js"
    },
    "./styles.css": {
      "development": "./src/Calendar.module.css",
      "import": "./lib/esm/Calendar.module.css",
      "require": "./lib/cjs/Calendar.module.css"
    },
    "./*.js": {
      "types": "./lib/esm/*.d.ts",
      "development": "./src/*.ts",
      "import": "./lib/esm/*.js",
      "require": "./lib/cjs/*.js"
    },
    "./*": {
      "types": "./lib/esm/*.d.ts",
      "development": "./src/*.ts",
      "import": "./lib/esm/*.js",
      "require": "./lib/cjs/*.js"
    }
  },
  "typesVersions": {
    "*": {
      "*": [
        "lib/esm/*"
      ]
    }
  },
  "dependencies": {
    "@_linked/core": "2.22.2",
    "@_linked/css": "0.3.0",
    "@_linked/primitives": "1.2.2",
    "rrule": "2.8.1"
  },
  "peerDependencies": {
    "react": "^18.2.0 || ^19.0.0",
    "react-dom": "^18.2.0 || ^19.0.0"
  },
  "devDependencies": {
    "@_linked/cli": "1.22.3",
    "@types/node": "^20.12.7",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "^5.9.2",
    "vitest": "^2.1.9"
  },
  "keywords": [
    "linked",
    "calendar",
    "scheduling",
    "rdf",
    "semantic-web"
  ]
}
